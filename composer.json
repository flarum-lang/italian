{
	"name": "flarum-lang/italian",
	"description": "Italian Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/italian",
	"license": "MIT",
	"authors": [
		{
			"name": "justoverclockl",
			"homepage": "https://github.com/justoverclockl",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/italian/issues",
		"forum": "https://discuss.flarum.org/d/40192",
		"source": "https://github.com/flarum-lang/italian"
	},
	"require": {
		"flarum/core": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "Italian",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundColor": "#fff",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "it",
			"title": "Italiano"
		}
	}
}
